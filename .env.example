# Copy to .env and edit to override the defaults baked into docker-compose.yml.

# Postgres
POSTGRES_DB=tally
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally
POSTGRES_PORT=5432

# Server
SERVER_PORT=8080
# Comma-separated list of allowed CORS origins, or * for any.
CORS_ALLOWED_ORIGINS=*
# JWT signing secret. Change this to a long random string in production.
JWT_SECRET=tally-dev-please-change-me

# Client
CLIENT_PORT=3000
# Where the frontend should send API requests. Must be reachable from the
# user's browser, not just from inside the docker network. For local dev:
REACT_APP_API_URL=http://localhost:8080
